# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Port the website listens on
PORT=3000

# Public address of the site, used for the "Open the tracker" button in emails
APP_URL=http://localhost:3000

# Optional: one shared passcode for the team (browser asks for it; any username)
TEAM_PASSCODE=

# Time zone for "today", the 6 PM summary and the morning delay check
TZ_NAME=Asia/Kolkata

# --- Email (SMTP). Leave SMTP_HOST empty to save emails to data/outbox instead of sending ---
# Office 365 / Outlook:  smtp.office365.com, port 587, SMTP_SECURE=false
# Gmail (app password):   smtp.gmail.com,     port 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MFI Project Tracker <tracker@yourcompany.com>"

# Where the live data is stored (default: ./data)
# DATA_DIR=/var/lib/mfi-tracker
